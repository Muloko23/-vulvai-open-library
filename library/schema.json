{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VULVAi Open Library module",
  "type": "object",
  "required": ["id", "title", "topic", "level", "review_status", "prerequisites", "lessons", "quiz", "faq"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "title": {"$ref": "#/$defs/localized"},
    "topic": {"enum": ["body", "puberty", "menstruation", "hygiene", "consent", "safety", "relationships", "emotions", "care_seeking"]},
    "level": {"type": "integer", "minimum": 1, "maximum": 5},
    "review_status": {"enum": ["draft", "community_reviewed", "clinically_verified"]},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "format", "script"],
        "properties": {
          "id": {"type": "string"},
          "format": {"enum": ["audio", "video", "story_card", "case_scenario", "group_activity"]},
          "script": {"$ref": "#/$defs/localized"},
          "audio": {"type": "string", "pattern": "^media/audio/[a-z0-9_]+\\.mp3$", "description": "Narration, relative to library/"},
          "video": {"type": "string", "pattern": "^media/video/[a-z0-9_]+\\.mp4$", "description": "Narrated, captioned video, relative to library/"},
          "image": {"type": "string", "pattern": "^media/images/[a-z0-9_]+\\.(svg|png|jpg)$", "description": "Illustration, relative to library/"}
        }
      }
    },
    "quiz": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "options", "answer"],
        "properties": {
          "question": {"$ref": "#/$defs/localized"},
          "options": {"type": "array", "items": {"$ref": "#/$defs/localized"}},
          "answer": {"type": "integer", "minimum": 0}
        }
      }
    },
    "faq": {
      "type": "array",
      "description": "Verified answers used for private question retrieval",
      "items": {
        "type": "object",
        "required": ["question", "answer", "keywords"],
        "properties": {
          "question": {"$ref": "#/$defs/localized"},
          "answer": {"$ref": "#/$defs/localized"},
          "keywords": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "required": ["en"],
      "description": "Text keyed by language code. Hindi (hi) and dialect versions are added by community translators and reviewed before release.",
      "additionalProperties": {"type": "string"}
    }
  }
}
